VITE_API_BASE_URL=/api/v1
VITE_OIDC_PROVIDER=keycloak
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=vortexbird
VITE_KEYCLOAK_CLIENT_ID=vortexbird-portal
# Enable ONLY when the API is Development and DemoAuth:Enabled=true.
VITE_DEMO_AUTH=false
# Required in Cognito mode: set the actual public pool issuer, app client ID and managed-login origin.
VITE_COGNITO_ISSUER=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_AUTHORIZATION_ORIGIN=
